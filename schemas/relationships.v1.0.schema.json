        "suppressed": {
          "items": {
            "type": "string"
          },
          "title": "Suppressed",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "child_table",
        "child_columns",
        "parent_table",
        "parent_columns",
        "source"
      ],
      "title": "ForeignKey",
      "type": "object"
    },
    "PrimaryKey": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "title": "Table",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "source": {
          "enum": [
            "declared",
            "config",
            "inferred"
          ],
          "title": "Source",
          "type": "string"
        },
        "alternatives": {
          "description": "Other unique column sets found.",
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Alternatives",
          "type": "array"
        }
      },
      "required": [
        "table",
        "columns",
        "source"
      ],
      "title": "PrimaryKey",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "profiler_version": {
      "title": "Profiler Version",
      "type": "string"
    },
    "k_threshold": {
      "minimum": 5,
      "title": "K Threshold",
      "type": "integer"
    },
    "tables": {
      "items": {
        "type": "string"
      },
      "title": "Tables",
      "type": "array"
    },
    "primary_keys": {
      "items": {
        "$ref": "#/$defs/PrimaryKey"
      },
      "title": "Primary Keys",
      "type": "array"
    },
    "foreign_keys": {
      "items": {
        "$ref": "#/$defs/ForeignKey"
      },
      "title": "Foreign Keys",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "profiler_version",
    "k_threshold",
    "tables"
  ],
  "title": "Relationships",
  "type": "object"
}
