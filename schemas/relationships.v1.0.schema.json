          },
          "title": "Quantiles",
          "type": "object"
        },
        "zero_children_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zero Children Share"
        }
      },
      "title": "ChildrenPerParent",
      "type": "object"
    },
    "ForeignKey": {
      "additionalProperties": false,
      "properties": {
        "child_table": {
          "title": "Child Table",
          "type": "string"
        },
        "child_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Child Columns",
          "type": "array"
        },
        "parent_table": {
          "title": "Parent Table",
          "type": "string"
        },
        "parent_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Parent Columns",
          "type": "array"
        },
        "source": {
          "enum": [
            "declared",
            "config",
            "inferred"
          ],
          "title": "Source",
          "type": "string"
        },
        "name_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Score"
        },
        "containment": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of non-null child rows whose value is in the parent key.",
          "title": "Containment"
        },
        "orphan_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of non-null child rows whose value is not in the parent key.",
          "title": "Orphan Rate"
        },
        "orphan_value_share": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Share of distinct non-null child values that are not in the parent key.",
          "title": "Orphan Value Share"
        },
        "children_per_parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChildrenPerParent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
